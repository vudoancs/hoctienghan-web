# Copy to .env.local (development) or set in your host's environment.
# All values here are PUBLIC (they appear in the generated HTML). Never put secrets here.

# Public origin of this website, no trailing slash. Required for canonical URLs, hreflang and sitemap.
SITE_URL=https://example.com

# Support / privacy contact shown on every page. Required.
SUPPORT_EMAIL=

# App Store page of the iOS app. Leave empty until it is live: the site shows "coming soon".
APP_STORE_URL=

# Backend API base URL (backend-api), no trailing slash. Enables web account deletion by
# email verification. The API's CORS_ORIGINS must include SITE_URL.
# Leave empty to show the support-email procedure instead.
API_BASE_URL=

# Optional postal address of the developer, shown in the privacy policy.
DEVELOPER_ADDRESS=
